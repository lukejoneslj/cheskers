# Firebase web config. Copy to .env.local and fill in from
#   Firebase console -> Project settings -> Your apps -> Web app
#
# These values are NOT secrets: they identify the project, they do not grant
# access. Access is controlled entirely by database.rules.json. Vite inlines
# anything prefixed VITE_ into the client bundle, which is expected here.
#
# Leave these unset and the game still runs perfectly as a local hotseat game;
# only the online lobby is disabled.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
